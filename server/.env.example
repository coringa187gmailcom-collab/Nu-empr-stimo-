# ========== Brevo (Sendinblue) ==========
# 1. Acesse https://app.brevo.com
# 2. SMTP & API → API Keys → Generate a new API key
# 3. Cole a chave abaixo:

BREVO_API_KEY=cole_sua_chave_aqui

# E-mail remetente (precisa estar verificado no Brevo)
# Em conta gratuita, use o e-mail com que você se cadastrou no Brevo
# ou adicione/verifique um remetente em: Senders, Domains & Dedicated IPs

BREVO_SENDER_EMAIL=seu-email@dominio.com
BREVO_SENDER_NAME=NU Empréstimo

# URL pública do site (usada no link de confirmação do e-mail)
# Em desenvolvimento local:
APP_URL=http://localhost:3000

# Porta do servidor
PORT=3000
